# Fase 0A - servico `web` (painel), hospedado na VERCEL
#
# Copie para .env.local e preencha. NUNCA versione.
#
# NENHUMA destas variaveis usa o prefixo NEXT_PUBLIC_, e isso e proposital:
# com esse prefixo o valor seria embutido no bundle e chegaria ao navegador,
# anulando o desenho inteiro. As tres sao lidas apenas no servidor.

# Dominio publico do servico `api` na Railway.
# https, nao http: agora e internet publica, nao rede privada.
# Local: http://localhost:8000
API_BASE_URL=https://SEU-SERVICO-api.up.railway.app

# O MESMO valor definido em API_SERVICE_TOKEN no servico `api`.
# Com a api publica na internet, ESTE TOKEN E A UNICA TRANCA (ADR 0010).
# Minimo 32 bytes url-safe:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SERVICE_TOKEN=S-iCuwDqOvkpvZVabLErJ-hGKW1GTAq1QbKfKJoavnE

# Senha de acesso humano ao painel. Vira cookie httpOnly apos o login.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
PANEL_TOKEN=
